@model BubbleBot.Website.Models.User
@{ string currentAction = ViewContext.RouteData.Values["action"].ToString(); }
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <title>Bubble Bot - @ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700,200" rel="stylesheet" />
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/latest/css/font-awesome.min.css" />
    <!-- CSS Files -->
    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/light-bootstrap.css" rel="stylesheet" />
    <link href="~/css/panel.css" rel="stylesheet" />
</head>
<body>
    <div class="wrapper">
        <div class="sidebar" data-image="../images/banniere.png" data-color="blue">
            <div class="sidebar-wrapper" style="margin: 0; height: 100%; overflow: hidden;">
                <div class="logo">
                    <a asp-action="Index" asp-controller="Home" class="simple-text">
                        <img src="~/images/Logo.png" width="30" height="30" class="d-inline-block align-top" alt="Logo">
                        Bubble Bot
                    </a>
                </div>
                <div class="row align-items-center justify-content-center w-100">
                    <img src="@Model.AvatarUrl" alt="Avatar" width="64" height="64" style="border-radius: 25px;" class="d-inline-block align-center" />
                    <h4 class="nav-link" style="font-weight:600;">@Model.Username</h4>
                </div>
                <div>
                    <h5 class="text-center">@(Model.IsSubscribedToTouch ? "Abonné" : "Non abonné")  <span class="badge badge-pill badge-warning">@Model.Points<span class="fa fa-star"></span></span></h5>
                </div>
                <hr />
                <ul class="nav">
                    <li class="nav-item @(currentAction == "Index" ? "active" : "")">
                        <a class="nav-link" asp-action="Index" asp-controller="Panel">
                            <i class="fa fa-home"></i>
                            <p>Accueil</p>
                        </a>
                    </li>
                    <li class="nav-item @(currentAction == "Points" ? "active" : "")">
                        <a class="nav-link" asp-action="Points" asp-controller="Panel">
                            <i class="fa fa-star"></i>
                            <p>Points</p>
                        </a>
                    </li>
                    <li class="nav-item @(currentAction == "Subscriptions" ? "active" : "")">
                        <a class="nav-link" asp-action="Subscriptions" asp-controller="Panel">
                            <i class="fa fa-shopping-cart"></i>
                            <p>Abonnements</p>
                        </a>
                    </li>
                    <li class="nav-item @(currentAction == "Extensions" ? "active" : "")">
                        <a class="nav-link" asp-action="Extensions" asp-controller="Panel">
                            <i class="fa fa-puzzle-piece"></i>
                            <p>Extensions</p>
                        </a>
                    </li>
                    <li class="nav-item @(currentAction == "Downloads" ? "active" : "")">
                        <a class="nav-link" asp-action="Downloads" asp-controller="Panel">
                            <i class="fa fa-download"></i>
                            <p>Téléchargements</p>
                        </a>
                    </li>
                    <li class="dropdown">
                        <a class="nav-link">
                            <i class="fa fa-bar-chart"></i> Statistiques<span class="fa fa-arrow-down fa-pull-right"></span>
                        </a>
                        <ul id="dropdown-menu-custom" class="dropdown-menu-custom">
                            <li class="nav-item @(currentAction == "BotsStats" ? "active" : "")"><a class="nav-link" asp-action="BotsStats" asp-controller="Panel">Bots</a></li>
                            <li class="nav-item @(currentAction == "Bots" ? "active" : "")"><a class="nav-link" href="#">Global</a></li>
                            <li class="nav-item @(currentAction == "Bots" ? "active" : "")"><a class="nav-link" href="#">Hôtel de Vente</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
        <div class="main-panel">
            <!-- Navbar -->
            <nav class="navbar navbar-expand-lg " color-on-scroll="500">
                <div class="container-fluid">
                    <a class="navbar-brand"> @ViewData["Title"]   </a>
                    <button href="" class="navbar-toggler navbar-toggler-right" type="button" data-toggle="collapse" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-bar burger-lines"></span>
                        <span class="navbar-toggler-bar burger-lines"></span>
                        <span class="navbar-toggler-bar burger-lines"></span>
                    </button>
                    <div class="collapse navbar-collapse justify-content-end" id="navigation">
                        <ul class="navbar-nav ml-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-action="UserProfile" asp-controller="Panel">
                                    <span class="fa fa-user"></span> Mon Compte
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-action="LogOut" asp-controller="Panel">
                                    <span class="fa fa-sign-out"></span> Se déconnecter
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            <div class="content">
                @RenderBody()
            </div>
            <footer class="footer">
                <div class="container-fluid">
                    <nav>
                        <ul class="footer-menu">
                            <li>
                                <a asp-action="Index" asp-controller="Home">
                                    Accueil
                                </a>
                            </li>
                            <li>
                                <a asp-action="Functionalities" asp-controller="Home">
                                    Fonctionnalités
                                </a>
                            </li>
                            <li>
                                <a asp-action="Galery" asp-controller="Home">
                                    Galerie
                                </a>
                            </li>
                            <li>
                                <a asp-action="Offers" asp-controller="Home">
                                    Offres
                                </a>
                            </li>
                        </ul>
                        <p class="copyright text-center">
                            ©
                            <script>
                                document.write(new Date().getFullYear())
                            </script>
                            <a href="http://bubblebot.fr">Bubble Bot</a>, A.K.A le roi des bots
                        </p>
                    </nav>
                </div>
            </footer>
        </div>
    </div>
    <!--   Core JS Files   -->
    <script src="https://kit.fontawesome.com/f6a13e7962.js" crossorigin="anonymous"></script>
    <script src="~/js/core/jquery.3.2.1.min.js" type="text/javascript"></script>
    <script src="~/js/core/popper.min.js" type="text/javascript"></script>
    <script src="~/js/core/bootstrap.min.js" type="text/javascript"></script>
    <script src="~/js/plugins/bootstrap-switch.js"></script>
    <script src="~/js/plugins/chartist.min.js"></script>
    <!--  Notifications Plugin    -->
    <script src="~/js/plugins/bootstrap-notify.js"></script>
    <script src="~/js/light-bootstrap.js" type="text/javascript"></script>
    <script src="~/js/site.js"></script>
    <script type="text/javascript">
        $(".dropdown").on("click", function () {
            $(this).find(".fa-arrow-down").toggleClass("caretup");
            $(this).find("#dropdown-menu-custom").toggleClass("dropdown-menu-custom-show");
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
