@model BubbleBot.Website.Models.User

@{
    ViewData["Title"] = "Compte";
}

<script src="~/js/core/jquery.3.2.1.min.js" type="text/javascript"></script>
<script type="text/javascript">
@if (ViewBag.Error != null)
{
    <text>
        $(document).ready(function() {
            site.showNotification("@Html.Raw(ViewBag.Error)", 4, 'top', 'right');
        });
    </text>
}
@if (ViewBag.Success != null)
{
    <text>
        $(document).ready(function() {
            site.showNotification("@ViewBag.Success", 2, 'top', 'right');
        });
    </text>
}
</script>
<script src="https://www.google.com/recaptcha/api.js?render=6LcGbtUUAAAAAIoPhzQcO3fhwtVo9oICwsAGBB0R"></script>

<script type="text/javascript">
    grecaptcha.ready(function () {
        grecaptcha.execute('6LcGbtUUAAAAAIoPhzQcO3fhwtVo9oICwsAGBB0R', { action: 'homepage' }).then(function (token) {
            document.getElementById("reCaptcha").value = token;
        });
    });
</script>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">Editer le Compte</h4>
                <h5 class="card-title">*Tous les champs sont facultatifs ! Vous pouvez les modifier à votre guise...</h5>
            </div>
            <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Nom d'utilisateur</label>
                                <text type="text" class="form-control" disabled>@Model.Username</text>
                            </div>
                        </div>
                        <div class="col-md-4 pr-1">
                            <div class="form-group">
                                <label for="exampleInputEmail1">Adresse E-Mail</label>
                                <text type="email" class="form-control" disabled>@Model.Email</text>
                            </div>
                        </div>
                    </div>
                <form enctype="multipart/form-data" asp-controller="Panel" asp-action="UserProfile" method="post">
                    <div class="row">
                        <div class="col-md-6 pr-1">
                            <div class="form-group">
                                <label>Prénom</label>
                                <input onkeypress="return /[a-z]/i.test(event.key)" minlength=2 maxlength=15 type="text" class="form-control" name="FirstName" placeholder="Prénom" value="@Model.FirstName">
                                <span></span>
                            </div>
                        </div>
                        <div class="col-md-6 pr-1">
                            <div class="form-group">
                                <label>Nom</label>
                                <input onkeypress="return /[a-z]/i.test(event.key)" minlength=2 maxlength=15 type="text" class="form-control" name="Surname" placeholder="Nom" value="@Model.Surname">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Pseudo Discord</label>
                                <input class="form-control" name="Discord" minlength=2 maxlength=18 placeholder="@@Discord" value="@Model.Discord">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>À propos de moi</label>
                                <input type="text" rows="4" cols="80" minlength=1 maxlength=255  class="form-control" name="Description" placeholder="Place ta description ici !" value="@Model.Description">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <div class="avatar-upload">
                                    <div class="avatar-edit">
                                        <input type='file' id="Avatar" name="Avatar" accept=".png, .jpg, .gif" />
                                        <label for="Avatar"></label>
                                    </div>
                                    <div class="avatar-preview">
                                        <div id="imagePreview" style="background-image: url(@Model.AvatarUrl);">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <input type="hidden" id="reCaptcha" name="reCaptcha" />
                    </div>
                    <button type="submit" class="btn btn-info btn-fill pull-right">Mettre à Jour</button>
                    <div class="clearfix"></div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="~/js/core/jquery.3.2.1.min.js" type="text/javascript"></script>
<script>
    function readURL(input) {
        if (input.files && input.files[0]) {
            if (input.files[0].size > 2097152) 
            {
                alert("La taille du fichier doit être inférieur à " + (2097152/1024/1024) + "Mo");
                return false;
            }
            var reader = new FileReader();
            reader.onload = function (e) {
                $('#imagePreview').css('background-image', 'url(' + e.target.result + ')');
                $('#imagePreview').hide();
                $('#imagePreview').fadeIn(650);
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
    $("#Avatar").change(function () {
        readURL(this);
    });
</script>