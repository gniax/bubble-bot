<Controls:MetroWindow
    xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
    x:Class="BubbleBot.WPF.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:enumConverters="clr-namespace:BubbleBot.Converters.Enums"
    xmlns:accounts="clr-namespace:BubbleBot.Views.Accounts"
    xmlns:otherConverters="clr-namespace:BubbleBot.Converters.Others"
    xmlns:groupsNs="clr-namespace:BubbleBot.Core.Groups"
    xmlns:accountsNs="clr-namespace:BubbleBot.Core.Accounts"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:behaviors="clr-namespace:BubbleBot.Behaviors"
    xmlns:specific="clr-namespace:BubbleBot.Converters.Specific"
    xmlns:_="clr-namespace:BubbleBot.Configurations.Language"
    GlowBrush="{DynamicResource AccentColorBrush}"
    BorderBrush="{StaticResource AccentColorBrush}"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanMinimize"
    Title="{Binding Server.Name, Mode=OneWay, StringFormat=Bubble Bot Touch - {0}}"
    Height="720" Width="1280" FontSize="14"
    ContentRendered="MetroWindow_ContentRendered" 
    IsManipulationEnabled="True">

    <Controls:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary x:Name="Colors" Source="../Theme/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <enumConverters:ServerConnectionStatesConverter x:Key="ServerConnectionStatesConverter" />
            <enumConverters:AccountStatesImageConverter x:Key="AccountStatesImageConverter" />
            <enumConverters:AccountStatesStringConverter x:Key="AccountStatesStringConverter" />
            <otherConverters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <specific:SubscriptionTextConverter x:Key="SubscriptionTextConverter" />

        </ResourceDictionary>
    </Controls:MetroWindow.Resources>

    <StackPanel>
        <StackPanel.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Black" Offset="1"/>
                <GradientStop Color="#FF00538D" Offset="1"/>
                <GradientStop Color="#FF033680" Offset="0.558"/>
                <GradientStop Color="#FF00050C" Offset="0"/>
                <GradientStop Color="#FF00050C" Offset="1"/>
            </LinearGradientBrush>
        </StackPanel.Background>

        <!-- Header -->

        <!-- Content -->
        <!-- Header -->

        <!-- Content -->
        <!-- Header -->
        <Grid Margin="10,0,808,8" Height="70" Background="{DynamicResource BaseBlackBrush}">
            <Grid.Effect>
                <DropShadowEffect Color="#ff403f3f" BlurRadius="10" ShadowDepth="4" Direction="270" />
            </Grid.Effect>

            <!-- Header's grid definitions -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- State hack -->
            <Grid Grid.ColumnSpan="2" Margin="0,17,-30,15" Width="30" Height="30" HorizontalAlignment="Right">
                <Ellipse Fill="{DynamicResource BaseBlackBrush}" />
                <Image Width="18"
                       Height="18"
                       Source="{Binding Server.State, Converter={StaticResource ServerConnectionStatesConverter}, Mode=OneWay}" />
            </Grid>

            <!-- First column -->
            <Ellipse Grid.Column="0" Width="50" Height="50" Stroke="#ff797979" StrokeThickness="2">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.6" />
                </Ellipse.Effect>
                <Ellipse.Fill>
                    <ImageBrush ImageSource="{Binding Server.AvatarUrl, IsAsync=True}" />
                </Ellipse.Fill>
            </Ellipse>

            <!-- Second column -->
            <DockPanel Width="900"
                       VerticalAlignment="Center"
                       Grid.Column="1"
                       Height="70">

                <!-- Buttons -->
                <Button x:Name="BtnAccountsManager"
                        Click="BtnAccountsManager_Click"
                        Width="44"
                        Height="44"
                        ToolTip="{_:Lang 464}"
                        Style="{DynamicResource MetroCircleButtonStyle}">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="6" Opacity="0.6" Color="Black" />
                    </Button.Effect>
                    <iconPacks:PackIconMaterial Width="18" Height="18" Kind="AccountMultiple" Foreground="White" />
                </Button>
                <Button x:Name="BtnQuickActions"
                        Click="BtnQuickActions_Click"
                        Width="44"
                        Height="44"
                        ToolTip="{_:Lang 575}"
                        Style="{DynamicResource MetroCircleButtonStyle}">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="6" Opacity="0.6" Color="Black" />
                    </Button.Effect>
                    <iconPacks:PackIconMaterial Width="18" Height="18" Kind="Flash" Foreground="White" />
                </Button>
                <Button x:Name="BtnPlanner"
                        Click="BtnPlanner_Click"
                        Width="44"
                        Height="44"
                        ToolTip="{_:Lang 600}"
                        Style="{DynamicResource MetroCircleButtonStyle}">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="6" Opacity="0.6" Color="Black" />
                    </Button.Effect>
                    <iconPacks:PackIconMaterial Width="18" Height="18" Kind="Timer" Foreground="White" />
                </Button>
                <Button x:Name="BtnOptions"
                        Click="BtnOptions_Click"
                        Width="44"
                        Height="44"
                        ToolTip="Options"
                        Style="{DynamicResource MetroCircleButtonStyle}">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="6" Opacity="0.6" Color="Black" />
                    </Button.Effect>
                    <iconPacks:PackIconMaterial Width="18" Height="18" Kind="Settings" Foreground="White" />
                </Button>
                <Button x:Name="BtnMinimize"
                        Width="44"
                        Height="44"
                        ToolTip="{_:Lang 465}"
                        Click="BtnMinimize_OnClick"
                        Style="{DynamicResource MetroCircleButtonStyle}">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="6" Opacity="0.6" Color="Black" />
                    </Button.Effect>
                    <iconPacks:PackIconMaterial Width="18" Height="18" Kind="ArrowDownBold" />
                </Button>

                <!-- Informations -->
                <Grid VerticalAlignment="Center" Margin="0 0 4 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0 -4 0 0"
                               HorizontalAlignment="Right"
                               Text="{Binding Server.TouchEndDate, Converter={StaticResource SubscriptionTextConverter}}" />
                    <TextBlock Grid.Row="1"
                               Margin="0 6 0 0"
                               HorizontalAlignment="Right">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{_:Lang 476}">
                                <Binding Path="Server.Statistics.AccountsConnected" />
                                <Binding Path="Server.Statistics.BotsConnected" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>

            </DockPanel>
        </Grid>

        <!-- Content -->
        <StackPanel Orientation="Horizontal" Margin="0 11 0 0" Height="600">

            <!-- Accounts headers -->
            <TreeView x:Name="treeView"
                      Margin="10 0 10 10"
                      Height="584"
                      Width="186"
                      Background="{DynamicResource BaseBlackBrush}"
                      ItemsSource="{Binding Entities}">

                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type groupsNs:Group}" ItemsSource="{Binding Members}">
                        <StackPanel>
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Connecter le groupe" Click="BtnConnectGroup_Click">
                                        <MenuItem.Icon>
                                            <iconPacks:PackIconMaterial Margin="8 0 0 0" Kind="PowerPlug" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Déconnecter le groupe" Click="BtnDisconnectGroup_Click">
                                        <MenuItem.Icon>
                                            <iconPacks:PackIconMaterial Margin="8 0 0 0" Kind="PowerPlugOff" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <Grid Height="40">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="15" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="116" />
                                </Grid.ColumnDefinitions>

                                <Image Grid.Row="0"
                                       Grid.Column="0"
                                       Grid.RowSpan="2"
                                       Width="18"
                                       Height="18"
                                       Source="{Binding Chief.State, Converter={StaticResource AccountStatesImageConverter}, Mode=OneWay}" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding Chief.AccountConfig.Username}"
                                           Margin="4 2 0 0" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding Chief.State, Converter={StaticResource AccountStatesStringConverter}, Mode=OneWay}"
                                           Margin="4 0 0 0"
                                           FontSize="10" />
                            </Grid>
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <DataTemplate DataType="{x:Type accountsNs:Account}">

                        <Grid Height="40">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22" />
                                <RowDefinition Height="15" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="116" />
                            </Grid.ColumnDefinitions>

                            <Image Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.RowSpan="2"
                                   Width="18"
                                   Height="18"
                                   Source="{Binding State, Converter={StaticResource AccountStatesImageConverter}, Mode=OneWay}" />
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding AccountConfig.Username}"
                                       Margin="4 2 0 0" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding State, Converter={StaticResource AccountStatesStringConverter}, Mode=OneWay}"
                                       Margin="4 0 0 0"
                                       FontSize="10" />
                        </Grid>
                    </DataTemplate>
                </TreeView.Resources>
                <i:Interaction.Behaviors>
                    <behaviors:BindableSelectedItemBehavior SelectedItem="{Binding SelectedAccount, Mode=TwoWay}" />
                </i:Interaction.Behaviors>

            </TreeView>

            <!-- Account UserControl -->
            <Grid Margin="4,-82,0,13"
                  Width="1056">
                <Border BorderThickness="292" BorderBrush="{DynamicResource BaseBlackBrush}" Margin="0,85,11,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14"
                                          Color="{DynamicResource ShadowColor}"
                                          ShadowDepth="0" />
                    </Border.Effect>
                </Border>
                <accounts:AccountUc DataContext="{Binding SelectedAccount}"
                                    Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}" BorderBrush="{x:Null}" />
            </Grid>

        </StackPanel>

    </StackPanel>
</Controls:MetroWindow>