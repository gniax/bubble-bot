<Controls:MetroWindow
    xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
    x:Class="BubbleBot.Views.AddSubstituteAccounts"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:_="clr-namespace:BubbleBot.Configurations.Language"
    mc:Ignorable="d"
    Title="{_:Lang 765}"
    ResizeMode="NoResize"
    ShowMaxRestoreButton="False"
    Height="300" Width="350"
    WindowStartupLocation="CenterScreen"
    GlowBrush="{DynamicResource AccentColorBrush}"
    BorderBrush="{StaticResource AccentColorBrush}"
    FontSize="12" ShowSystemMenuOnRightClick="False">


    <StackPanel Margin="6,0,4,5">
        <StackPanel Margin="0, 15, 0, 0">
            <DockPanel Margin="4" VerticalAlignment="Stretch">
                <TextBox x:Name="TxtContent"
                         TextWrapping="Wrap" 
                         AcceptsReturn="True" 
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         Height="80"/>
            </DockPanel>
        </StackPanel>
        <StackPanel>
            <StackPanel Height="55" Margin="0,20,0.2,0" Orientation="Vertical" Width="339">
                <iconPacks:PackIconMaterial Width="14"
                                            Height="14"
                                            HorizontalAlignment="Center"
                                            Kind="Information" Margin="155,0,154.2,0" />
                <TextBlock Margin="4,10,-0.8,0"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Text="{_:Lang 762}" />
            </StackPanel>
            
                <Button HorizontalAlignment="Left"
                    Name="BtnAdd"
                    Margin="176,10,0,0"
                    Width="129" Height="28"
                    Background="{StaticResource AccentColorBrush}"
                    Click="BtnAdd_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Check" />
                    <TextBlock Margin="4 0 0 0" Text="{_:Lang 635}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Controls:MetroWindow>