<Controls:MetroWindow
    xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
    x:Class="BubbleBot.Views.AddSubstituteAccount"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:_="clr-namespace:BubbleBot.Configurations.Language"
    mc:Ignorable="d"
    Title="{_:Lang 764}"
    ResizeMode="NoResize"
    ShowMaxRestoreButton="False"
    Height="135" Width="339"
    WindowStartupLocation="CenterScreen"
    GlowBrush="{DynamicResource AccentColorBrush}"
    BorderBrush="{StaticResource AccentColorBrush}"
    FontSize="12" ShowSystemMenuOnRightClick="False">


    <StackPanel Margin="6,0,4,5">
        <StackPanel Margin="0, 15, 0, 0">
            <DockPanel Margin="4" VerticalAlignment="Stretch">
                <TextBox x:Name="TxtUsername"
                         Controls:TextBoxHelper.ClearTextButton="True"
                         HorizontalAlignment="Left"
                         Controls:TextBoxHelper.Watermark="{_:Lang 244}"
                         Height="26" Margin="5, 3, 0, 0"
                         Width="150"
                         VerticalAlignment="Stretch"/>
                <TextBox x:Name="TxtPassword"
                         Controls:TextBoxHelper.ClearTextButton="True"
                         HorizontalAlignment="Left"
                         Controls:TextBoxHelper.Watermark="{_:Lang 245}"
                         Height="26" Margin="5, 3, 0, 0"
                         Width="150"
                         VerticalAlignment="Stretch"/>
            </DockPanel>
        </StackPanel>
        <Button HorizontalAlignment="Left"
                Name="BtnAdd"
                Margin="176,10,0,0"
                Width="129" Height="28"
                Background="{StaticResource AccentColorBrush}"
                Click="BtnAdd_Click">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="Check" />
                <TextBlock Margin="10 0 0 0" Text="{_:Lang 635}" />
            </StackPanel>
        </Button>
    </StackPanel>
</Controls:MetroWindow>