<Controls:MetroWindow
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        x:Class="BubbleBot.Views.ExportFormatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:_="clr-namespace:BubbleBot.Configurations.Language"
        mc:Ignorable="d"
        Title="{_:Lang 660}"
        ResizeMode="NoResize"
        ShowMaxRestoreButton="False"
        Height="300" Width="339"
        WindowStartupLocation="CenterScreen"
        GlowBrush="{DynamicResource AccentColorBrush}"
        BorderBrush="{StaticResource AccentColorBrush}"
        FontSize="12" ShowSystemMenuOnRightClick="False">

    
    <StackPanel Margin="6,0,4,5">
        <StackPanel Name="spAlert" 
                    Background="#cd5d5d" 
                    Visibility="Hidden"
                    Width="380" 
                    Margin="0 10 0 0">
            <TextBlock Name="tbAlert"
                       TextWrapping="Wrap"
                       Foreground="White"
                       Margin="10 8 10 10"/>
        </StackPanel>
        <StackPanel Margin="0, 10, 0, 0">
            <TextBox Controls:TextBoxHelper.ClearTextButton="True"
                     Controls:TextBoxHelper.Watermark="{_:Lang 662}" 
                     x:Name="txtFormat" Height="26" Margin="23,0,17.2,0" />
            <StackPanel Height="120" Margin="0,20,0.2,0" Orientation="Vertical" Width="339">
                <iconPacks:PackIconMaterial Width="14" 
                                        Height="14"
                                        HorizontalAlignment="Center"
                                        Kind="Information" Margin="155,0,154.2,0"/>
                <TextBlock Margin="4,10,-0.8,0"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center">
                    <Run Text="{_:Lang 661}"/>
                    <LineBreak/>
                    <Run Text="{_:Lang 667}"/>
                    <LineBreak/>
                    <LineBreak/>
                    <Run Text="{_:Lang 666}"/>
                    <LineBreak/>
                    <Run Text="{_:Lang 668}"/>
                </TextBlock>

            </StackPanel>
        </StackPanel>
        <Button HorizontalAlignment="Left" 
                x:Name="validateFormat"
                Margin="176,0,0,0"
                Width="129" Height="28"
                Background="{StaticResource AccentColorBrush}"
                Click="btn_formatValidation">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="Check" />
                <TextBlock Margin="10 0 0 0" Text="{_:Lang 635}" />
            </StackPanel>
        </Button>
    </StackPanel>
</Controls:MetroWindow>
