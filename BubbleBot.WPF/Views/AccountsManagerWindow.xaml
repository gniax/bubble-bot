<Controls:MetroWindow
    xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
    x:Class="BubbleBot.Views.AccountsManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:_="clr-namespace:BubbleBot.Configurations.Language"
    xmlns:others="clr-namespace:BubbleBot.Converters.Others"
    xmlns:enums="clr-namespace:BubbleBot.Converters.Enums"
    xmlns:specific="clr-namespace:BubbleBot.Converters.Specific"
    xmlns:forms="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
    xmlns:local="clr-namespace:BubbleBot.Views"
    mc:Ignorable="d"
    GlowBrush="{DynamicResource AccentColorBrush}"
    BorderBrush="{StaticResource AccentColorBrush}"
    ShowMaxRestoreButton="False"
    WindowStartupLocation="CenterOwner"    
    Title="{_:Lang 237}"
    Height="550"
    Width="855.285" IsManipulationEnabled="True" RightWindowCommandsOverlayBehavior="Never" ResizeMode="CanMinimize">

    <Window.Resources>
        <Style x:Key="SeparatorStyle" TargetType="{x:Type Separator}">
            <Setter Property="Background" Value="{DynamicResource GrayBrush8}" />
            <Setter Property="Margin" Value="8,0,8,0" />
            <Setter Property="Focusable" Value="false" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Background="{TemplateBinding Background}"
                        Width="1"
                        SnapsToDevicePixels="true" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Converters -->
        <others:NullImageConverter x:Key="NullImageConverter" />
        <others:NullHeadImageConverter x:Key="NullHeadImageConverter" />
        <specific:AccountStateToStringConverter x:Key="AccountStateToStringConverter" />
        <enums:EnumBooleanConverter x:Key="EnumBooleanConverter" />

    </Window.Resources>

    <TabControl Controls:TabControlHelper.Underlined="TabPanel"
                TabStripPlacement="Left" Margin="0,0,0,6">

        <!-- Connect accounts -->
        <TabItem Controls:ControlsHelper.HeaderFontSize="16" Width="213">
            <TabItem.HeaderTemplate>
                <DataTemplate>
                    <StackPanel Height="22" Margin="0 2 0 0" Orientation="Horizontal">
                        <iconPacks:PackIconMaterial VerticalAlignment="Center" Kind="AccountMultiple" />
                        <TextBlock VerticalAlignment="Center" FontSize="15" Margin="10 0 0 0" Text="{_:Lang 458}" />
                    </StackPanel>
                </DataTemplate>
            </TabItem.HeaderTemplate>
            <DockPanel LastChildFill="False">
                <GroupBox Header="{_:Lang 390}"
                          Name="GbGroup"
                          IsEnabled="False"
                          Visibility="Visible"
                          DockPanel.Dock="Bottom">
                    <StackPanel>
                        <DockPanel Margin="4">
                            <TextBlock Text="{_:Lang 391}" VerticalAlignment="Center" />
                            <ComboBox Margin="4 0 0 0"
                                      Name="CmbChief"
                                      ItemsSource="{Binding SelectedItems, ElementName=LvAccounts}"
                                      DisplayMemberPath="Username" />
                        </DockPanel>
                        <DockPanel HorizontalAlignment="Right">
                            <Button
                                Width="100" Height="30"
                                Margin="4 4 4 4"
                                HorizontalContentAlignment="Stretch"
                                Background="{StaticResource AccentColorBrush}"
                                Click="BtnLoadGroup_Click">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ProgressUpload" />
                                    <TextBlock Margin="11 1 0 0" Text="{_:Lang 681}" />
                                </StackPanel>
                            </Button>
                            <Button HorizontalAlignment="Right"
                                    Width="100" Height="30"
                                    Margin="4"
                                    HorizontalContentAlignment="Stretch"
                                    Background="{StaticResource AccentColorBrush}"
                                    Click="BtnConnectGroup_Click">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="AccountMultiple" />
                                    <TextBlock Margin="10 0 0 0" Text="{_:Lang 238}" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>
                <ListView Margin="4 6 4 4"
                          x:Name="LvAccounts"
                          SelectionMode="Extended"
                          MouseDoubleClick="LvAccounts_MouseDoubleClick"
                          SelectionChanged="LvAccounts_SelectionChanged"
                          IsSynchronizedWithCurrentItem="True"
                          ItemsSource="{Binding AccountsList}" Width="621">
                    <ListView.ContextMenu>
                        <ContextMenu Width="220">
                            <MenuItem Foreground="White"
                                    Header="{_:Lang 681}"
                                      Click="BtnLoadAccounts_Click">
                                <MenuItem.Icon>
                                    <iconPacks:PackIconMaterial Margin="8 0 0 0" Kind="ProgressUpload" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{_:Lang 238}"
                                      Click="BtnConnectAccounts_Click">
                                <MenuItem.Icon>
                                    <iconPacks:PackIconMaterial Margin="8 0 0 0" Kind="ArrowLeftBoldCircle" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{_:Lang 750}"
                                      Click="BtnCreateCharacter_Click">
                                <MenuItem.Icon>
                                    <iconPacks:PackIconMaterial Margin="8 0 0 0" VerticalAlignment="Center" Kind="AccountMultiplePlus" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Trier" Foreground="White">
                                <MenuItem.Icon>
                                    <iconPacks:PackIconMaterial Margin="8 0 0 0" Kind="Sort" />
                                </MenuItem.Icon>
                                <MenuItem.Items>
                                    <MenuItem Header="par Pseudo" Click="BtnSortByPseudo" />
                                </MenuItem.Items>
                            </MenuItem>
                            <MenuItem Header="Editer">
                                <MenuItem.Icon>
                                    <iconPacks:PackIconMaterial Margin="8 0 0 0" Kind="AccountEdit" />
                                </MenuItem.Icon>
                                <MenuItem.Items>
                                    <MenuItem Header="Pseudo" Click="BtnEditPseudo" />
                                    <MenuItem Header="Compte" Click="BtnEditAccount" />
                                </MenuItem.Items>
                            </MenuItem>
                            <MenuItem Header="Exporter">
                                <MenuItem.Icon>
                                    <iconPacks:PackIconMaterial Margin="8 0 0 0" Kind="Export" />
                                </MenuItem.Icon>
                                <MenuItem.Items>
                                    <MenuItem Header=".txt" Click="ExportAccountTxt_Click" />
                                </MenuItem.Items>
                            </MenuItem>
                            <MenuItem Header="{_:Lang 239}" Click="BtnDeleteAccounts_Click">
                                <MenuItem.Icon>
                                    <iconPacks:PackIconMaterial Margin="8 0 0 0" Kind="Delete" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="160">
                                <Border BorderThickness="0 0 0 1" BorderBrush="White">
                                    <TextBlock FontSize="11" Width="140" Text="{_:Lang 240}" />
                                </Border>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Username}" Foreground="{Binding UsernameColor }" ToolTip="{Binding State, Converter={StaticResource AccountStateToStringConverter}}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="110" DisplayMemberBinding="{Binding Server}">
                                <Border BorderThickness="0 0 0 1" BorderBrush="White">
                                    <TextBlock FontSize="11" Width="90" Text="{_:Lang 241}" />
                                </Border>
                            </GridViewColumn>
                            <GridViewColumn Width="130" DisplayMemberBinding="{Binding Character}">
                                <Border BorderThickness="0 0 0 1" BorderBrush="White">
                                    <TextBlock FontSize="11" Width="110" Text="{_:Lang 242}" />
                                </Border>
                            </GridViewColumn>
                            <GridViewColumn Width="110" DisplayMemberBinding="{Binding Nickname}">
                                <Border BorderThickness="0 0 0 1" BorderBrush="White">
                                    <TextBlock FontSize="11" Width="122" Text="{_:Lang 243}" />
                                </Border>
                            </GridViewColumn>
                            <GridViewColumn Width="110" DisplayMemberBinding="{Binding Identifiant}">
                                <Border BorderThickness="0 0 0 1" BorderBrush="White" Width="107">
                                    <TextBlock FontSize="11" Text="{_:Lang 644}" Margin="10,0,-10,0" />
                                </Border>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </TabItem>

        <!-- Add account -->
        <TabItem Controls:ControlsHelper.HeaderFontSize="16" Width="213">
            <TabItem.HeaderTemplate>
                <DataTemplate>
                    <StackPanel Height="22" Margin="0 2 0 0" Orientation="Horizontal">
                        <iconPacks:PackIconMaterial VerticalAlignment="Center" Kind="AccountMultiplePlus" />
                        <TextBlock VerticalAlignment="Center" FontSize="15" Margin="10 0 0 0" Text="{_:Lang 459}" />
                    </StackPanel>
                </DataTemplate>
            </TabItem.HeaderTemplate>

            <StackPanel>
                <!-- Add an account -->
                <GroupBox Header="Ajouter un compte" Height="285">
                    <StackPanel Orientation="Vertical">
                        <TextBox Margin="0 0 0 10"
                                 Controls:TextBoxHelper.ClearTextButton="True"
                                 Controls:TextBoxHelper.Watermark="{_:Lang 244}"
                                 Name="TxtUsername" />
                        <PasswordBox Margin="0 0 0 10"
                                     Controls:TextBoxHelper.ClearTextButton="True"
                                     Controls:TextBoxHelper.Watermark="{_:Lang 245}"
                                     Style="{StaticResource Win8MetroPasswordBox}"
                                     FontSize="13"
                                     Name="TxtPassword" />
                        <ComboBox Margin="0 0 0 10"
                                  Controls:TextBoxHelper.Watermark="{_:Lang 246}"
                                  SelectedIndex="0"
                                  Name="CmbServer">
                            <ComboBoxItem Content="-" />
                            <ComboBoxItem Content="Terra Cogita" />
                            <ComboBoxItem Content="Herdegrize" />
                            <ComboBoxItem Content="Oshimo" />
                            <ComboBoxItem Content="Dodge" />
                            <ComboBoxItem Content="Brutas" />
                            <ComboBoxItem Content="Grandapan" />
                        </ComboBox>
                        <TextBox Margin="0 0 0 10"
                                 Controls:TextBoxHelper.ClearTextButton="True"
                                 Controls:TextBoxHelper.Watermark="{_:Lang 247}"
                                 Name="TxtCharacter" />
                        <TextBox Margin="0 0 0 10"
                                 Controls:TextBoxHelper.ClearTextButton="True"
                                 Controls:TextBoxHelper.Watermark="{_:Lang 248}"
                                 Name="TxtNickname" />
                        <TextBox Margin="0 0 0 8"
                                 Controls:TextBoxHelper.ClearTextButton="True"
                                 Controls:TextBoxHelper.Watermark="{_:Lang 645}"
                                 x:Name="TxtIdentifiant" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnAddAccount"
                                    Width="81" Height="33"
                                    Background="{StaticResource AccentColorBrush}"
                                    Click="BtnAddAccount_Click">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Plus" />
                                    <TextBlock Margin="10 0 0 0" Text="{_:Lang 260}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Importer des comptes" Height="250">
                    <TabControl Controls:TabControlHelper.Underlined="TabPanel" Margin="0,0,0,23">
                        <!-- From a file -->
                        <TabItem>
                            <TabItem.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Height="20" Margin="0 2 0 0" Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial VerticalAlignment="Center" Kind="FileDocument" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="15"
                                                   Margin="10 0 0 0"
                                                   Text="{_:Lang 544}" />
                                    </StackPanel>
                                </DataTemplate>
                            </TabItem.HeaderTemplate>

                            <StackPanel Margin="4 0" VerticalAlignment="Center">
                                <DockPanel Margin="4">
                                    <RadioButton x:Name="RdbtnDefault"  GroupName="ImportFormat" VerticalAlignment="Center" IsChecked="True" Click="ImportDefaultRdbtn_Click" />
                                    <TextBlock Text="{_:Lang 744}" VerticalAlignment="Center" />
                                    <TextBox x:Name="TxtSeparatorDefaultPreview"
                                             IsEnabled="False"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{_:Lang 546}" Margin="4 0" VerticalAlignment="Center" />
                                    <TextBox x:Name="TxtSeparator"
                                             Margin="4 0"
                                             TextChanged="TxtSeparator_OnTextChanged" />
                                </DockPanel>
                                <DockPanel Margin="4">
                                    <RadioButton x:Name="RdbtnCustom" GroupName="ImportFormat" VerticalAlignment="Center" Click="ImportCustomRdbtn_Click"/>
                                    <TextBlock Text="{_:Lang 745}" VerticalAlignment="Center" />
                                    <TextBox x:Name="TxtCustomImportFormat" Text="..." VerticalAlignment="Center" IsEnabled="False" />
                                </DockPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{_:Lang 547}" Margin="0 0 0 4" />
                                    <DockPanel>
                                        <TextBox x:Name="TxtFilePath" Width="430" />
                                        <Button Content="..." Margin="4 0 0 0" Click="BtnSelectFilePath_OnClick" />
                                    </DockPanel>
                                </StackPanel>
                                <Button x:Name="BtnImportAccounts"
                                        Width="90" Height="32"
                                        HorizontalAlignment="Right"
                                        Margin="4 4 4 0"
                                        Click="BtnImportAccounts_OnClick"
                                        Background="{StaticResource AccentColorBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="FileImport" />
                                        <TextBlock Margin="10 0 0 0" Text="{_:Lang 492}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </TabItem>

                        <!-- Incrementing -->
                        <TabItem>
                            <TabItem.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Height="20" Margin="0 2 0 0" Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial VerticalAlignment="Center" Kind="ChevronDoubleUp" />
                                        <TextBlock VerticalAlignment="Center" FontSize="15" Margin="10 0 0 0"
                                                   Text="{_:Lang 545}" />
                                    </StackPanel>
                                </DataTemplate>
                            </TabItem.HeaderTemplate>

                            <StackPanel Margin="4 0" VerticalAlignment="Center">
                                <TextBox Margin="4"
                                         Controls:TextBoxHelper.ClearTextButton="True"
                                         Controls:TextBoxHelper.Watermark="{_:Lang 244}"
                                         x:Name="TxtUsernameIncr"
                                         TextChanged="TxtUsernameIncr_OnTextChanged" />
                                <PasswordBox Margin="4"
                                             Controls:TextBoxHelper.ClearTextButton="True"
                                             Controls:TextBoxHelper.Watermark="{_:Lang 245}"
                                             Style="{StaticResource Win8MetroPasswordBox}"
                                             x:Name="TxtPasswordIncr" />
                                <DockPanel Margin="4">
                                    <TextBlock Text="{_:Lang 549}" VerticalAlignment="Center" />
                                    <Controls:NumericUpDown x:Name="NudStartIncr"
                                                            Minimum="0"
                                                            Value="0"
                                                            Margin="4 0"
                                                            ValueChanged="NudIncr_OnValueChanged"
                                                            Width="144" />
                                    <TextBlock Text="{_:Lang 550}" VerticalAlignment="Center" />
                                    <Controls:NumericUpDown x:Name="NudEndIncr"
                                                            Minimum="1"
                                                            Value="10"
                                                            Margin="4 0 0 0"
                                                            ValueChanged="NudIncr_OnValueChanged" />
                                </DockPanel>
                                <TextBlock x:Name="TxtIncrPreview" Margin="4 2 4 6" HorizontalAlignment="Right" />
                                <Button x:Name="BtnImportAccountsIncr"
                                        Width="90" Height="32"
                                        HorizontalAlignment="Right"
                                        Margin="4 0 4 0"
                                        Click="BtnImportAccountsIncr_OnClick"
                                        Background="{StaticResource AccentColorBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="FileImport" />
                                        <TextBlock Margin="10 0 0 0" Text="{_:Lang 492}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </GroupBox>

                <!-- Import acounts -->
            </StackPanel>
        </TabItem>

        <!-- Characters creator -->
        <TabItem Controls:ControlsHelper.HeaderFontSize="16" Width="213">
            <TabItem.HeaderTemplate>
                <DataTemplate>
                    <StackPanel Height="22" Margin="0 2 0 0" Orientation="Horizontal">
                        <iconPacks:PackIconMaterial VerticalAlignment="Center" Kind="AccountPlus" />
                        <TextBlock VerticalAlignment="Center" FontSize="15"
                                   Margin="10 0 0 0" Text="{_:Lang 500}" />
                    </StackPanel>
                </DataTemplate>
            </TabItem.HeaderTemplate>

            <StackPanel Orientation="Horizontal" Margin="4">
                <!-- Accounts list -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Name="BtnSelectAll"
                                Click="BtnSelectAll_OnClick"
                                BorderThickness="0"
                                Background="Transparent"
                                Tag="0"
                                ToolTip="{_:Lang 502}">
                            <iconPacks:PackIconMaterial Width="12" Height="12" Kind="SelectAll" />
                        </Button>
                        <Button Name="BtnUnselectAll"
                                Click="BtnUnselectAll_OnClick"
                                BorderThickness="0"
                                Background="Transparent"
                                Tag="0"
                                ToolTip="{_:Lang 503}">
                            <iconPacks:PackIconMaterial Width="12" Height="12" Kind="SelectOff" />
                        </Button>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding AccountsList}"
                             Name="LbAccounts"
                             SelectionChanged="LbAccounts_SelectionChanged"
                             SelectionMode="Multiple"
                             Width="150" Height="472"
                             BorderThickness="0.6">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel VerticalAlignment="Stretch">
                                    <CheckBox Margin="-1 1 0 0"
                                              IsChecked="{Binding IsSelected, 
                                                          RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}">
                                    </CheckBox>
                                    <TextBlock Text="{Binding Username}" />
                                    <Image Name="CharacterCreatorPreview"
                                           Width="16" 
                                           HorizontalAlignment="Right"
                                           Source="{Binding Path=., 
                                            Mode=OneWay,
                                            Converter={StaticResource NullHeadImageConverter}}" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- Character options -->
                <StackPanel VerticalAlignment="Center">
                    <GroupBox Margin="4 0 4 4" Width="376">
                        <StackPanel>

                            <!-- Name -->
                            <DockPanel Margin="4">
                                <TextBlock Text="Nom: " VerticalAlignment="Center" />
                                <TextBox Controls:TextBoxHelper.ClearTextButton="True"
                                         Controls:TextBoxHelper.Watermark="{_:Lang 505}"
                                         Name="TxtName" />
                            </DockPanel>

                            <!-- Server -->
                            <DockPanel Margin="4">
                                <TextBlock Text="{_:Lang 506}" VerticalAlignment="Center" />
                                <ComboBox SelectedIndex="0"
                                          Name="CmbServerCC">
                                    <ComboBoxItem Content="Terra Cogita" />
                                    <ComboBoxItem Content="Herdegrize" />
                                    <ComboBoxItem Content="Oshimo" />
                                    <ComboBoxItem Content="Dodge" />
                                    <ComboBoxItem Content="Brutas" />
                                    <ComboBoxItem Content="Grandapan" />
                                </ComboBox>
                            </DockPanel>

                            <!-- Race -->
                            <DockPanel Margin="4">
                                <TextBlock Text="Race: " VerticalAlignment="Center" />
                                <CheckBox Name="CbRandomBreed"
                                          Content="{_:Lang 507}"
                                          Margin="4 0 0 0"
                                          DockPanel.Dock="Right" />
                                <ComboBox Name="CmbRace"
                                          SelectionChanged="CmbRace_OnSelectionChanged"
                                          DisplayMemberPath="ShortNameId" />
                            </DockPanel>

                            <!-- Sex -->
                            <DockPanel Margin="4">
                                <TextBlock Text="Sexe: " VerticalAlignment="Center" />
                                <CheckBox Name="CbRandomSex"
                                          Content="{_:Lang 507}"
                                          Margin="4 0 0 0"
                                          DockPanel.Dock="Right" />
                                <ComboBox Name="CmbSex" SelectedIndex="0" SelectionChanged="CmbSex_OnSelectionChanged">
                                    <ComboBoxItem>
                                        <DockPanel>
                                            <Image Source="/Bubble Bot;component/Resources/male16.png" />
                                            <TextBlock Text="{_:Lang 508}" />
                                        </DockPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem>
                                        <DockPanel>
                                            <Image Source="/Bubble Bot;component/Resources/female16.png" />
                                            <TextBlock Text="{_:Lang 509}" />
                                        </DockPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                            </DockPanel>

                            <!-- Head -->
                            <DockPanel Margin="4">
                                <TextBlock Text="Tête: " VerticalAlignment="Center" />
                                <CheckBox Name="CbRandomHead"
                                          Content="{_:Lang 507}"
                                          Margin="4 0 0 0"
                                          DockPanel.Dock="Right" />
                                <ComboBox Name="CmbHead" VerticalContentAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Image Width="40"
                                                   HorizontalAlignment="Center"
                                                   Source="{Binding Path=., 
                                                                Mode=OneWay,
                                                                IsAsync=True, 
                                                                Converter={StaticResource NullImageConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DockPanel>

                            <!-- Colors -->
                            <StackPanel Margin="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Rectangle Name="RectColor1" Margin="0 4 4 4"
                                           Width="32" Height="32"
                                           MouseLeftButtonUp="ColorRects_OnMouseLeftButtonUp" />
                                <Rectangle Name="RectColor4" Margin="4"
                                           Width="32" Height="32"
                                           MouseLeftButtonUp="ColorRects_OnMouseLeftButtonUp" />
                                <Rectangle Name="RectColor2" Margin="0 4 4 4"
                                           Width="32" Height="32"
                                           MouseLeftButtonUp="ColorRects_OnMouseLeftButtonUp" />
                                <Rectangle Name="RectColor5" Margin="4"
                                           Width="32" Height="32"
                                           MouseLeftButtonUp="ColorRects_OnMouseLeftButtonUp" />
                                <Rectangle Name="RectColor3" Margin="0 4 4 4"
                                           Width="32" Height="32"
                                           MouseLeftButtonUp="ColorRects_OnMouseLeftButtonUp" />
                                <Button Name="BtnRandomColors"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Click="BtnRandomColors_OnClick"
                                        ToolTip="Générer des couleurs aléatoirement">
                                    <iconPacks:PackIconMaterial Width="12" Height="12" Kind="DiceMultipleOutline" />
                                </Button>
                                <Button Name="BtnRefreshColors"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Click="BtnRefreshColors_OnClick"
                                        ToolTip="Réinitialiser les couleurs">
                                    <iconPacks:PackIconMaterial Width="12" Height="12" Kind="Refresh" />
                                </Button>
                                <CheckBox Name="CbRandomColors"
                                          Content="{_:Lang 507}"
                                          Margin="4 0 0 0"
                                          DockPanel.Dock="Right" />
                            </StackPanel>

                            <!-- Configurations -->
                            <GroupBox Header="{_:Lang 510}"
                                      Height="108">
                                <StackPanel>
                                    <DockPanel Margin="4">
                                        <TextBlock Text="{_:Lang 511}" VerticalAlignment="Center" />
                                        <ComboBox Name="CmbParameters" />
                                    </DockPanel>
                                    <DockPanel Margin="4">
                                        <TextBlock Text="{_:Lang 512}" VerticalAlignment="Center" />
                                        <ComboBox Name="CmbFightsConfigurations" />
                                    </DockPanel>
                                </StackPanel>
                            </GroupBox>

                            <CheckBox Content="{_:Lang 513}"
                                      Name="CmbCompleteTutorial"
                                      Checked="CmbCompleteTutorial_OnChecked"
                                      Margin="4" />

                        </StackPanel>
                    </GroupBox>

                    
                    <DockPanel>
                        <Button Width="85" Height="32"
                                Visibility="Hidden"
                                Name="BtnReset"
                                Click="BtnReset_Click"
                                HorizontalAlignment="Center"
                                Background="{StaticResource AccentColorBrush}"
                                Margin="10 4 2 0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Close" />
                                <TextBlock Margin="10 0 0 0" Text="Reset" />
                            </StackPanel>
                        </Button>

                        <DockPanel HorizontalAlignment="Right">
                            <Button Width="104" Height="32"
                                    Name="BtnSave"
                                    Click="BtnSave_OnClick"
                                    HorizontalAlignment="Right"
                                    Background="{StaticResource AccentColorBrush}"
                                    Margin="4 4 2 0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="CheckBold" />
                                    <TextBlock Margin="10 0 0 0" Text="{_:Lang 362}" />
                                </StackPanel>
                            </Button>
                            <Button Width="160" Height="32"
                                    Name="BtnSaveAndConnect"
                                    Click="BtnSaveAndConnect_OnClick"
                                    HorizontalAlignment="Right"
                                    Background="{StaticResource AccentColorBrush}"
                                    Margin="4 4 4 0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="CheckBold" />
                                    <TextBlock Margin="10 0 0 0" Text="{_:Lang 514}" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </DockPanel>

                </StackPanel>
            </StackPanel>
        </TabItem>

        <!-- Configurations copier -->
        <TabItem Controls:ControlsHelper.HeaderFontSize="16" Width="213">
            <TabItem.HeaderTemplate>
                <DataTemplate>
                    <StackPanel Height="22" Margin="0 2 0 0" Orientation="Horizontal">
                        <iconPacks:PackIconMaterial VerticalAlignment="Center" Kind="AccountSwitch" />
                        <TextBlock VerticalAlignment="Center" FontSize="15"
                                   Margin="10 0 0 0" Text="{_:Lang 558}" />
                    </StackPanel>
                </DataTemplate>
            </TabItem.HeaderTemplate>

            <StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0 8"
                            HorizontalAlignment="Center">
                    <iconPacks:PackIconMaterial Width="18"
                                                Height="18"
                                                Kind="Information"
                                                VerticalAlignment="Center" />
                    <TextBlock Margin="4 0 0 0"
                               Text="{_:Lang 761}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="4" VerticalAlignment="Top">
                    <!-- From -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Click="BtnSelectAll_OnClick"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Tag="1"
                                    ToolTip="{_:Lang 502}">
                                <iconPacks:PackIconMaterial Width="12" Height="12" Kind="SelectAll" />
                            </Button>
                            <Button Click="BtnUnselectAll_OnClick"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Tag="1"
                                    ToolTip="{_:Lang 503}">
                                <iconPacks:PackIconMaterial Width="12" Height="12" Kind="SelectOff" />
                            </Button>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Accounts}"
                                 Name="LbAccountsCopier"
                                 SelectionMode="Multiple"
                                 Width="160" Height="440"
                                 BorderThickness="0.6">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Username}"
                                              Margin="-1 1 0 0"
                                              IsChecked="{Binding IsSelected, 
                                                      RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- To -->
                    <GroupBox Header="{_:Lang 510}" Margin="10 26 0 0"
                              Height="150" Width="356"
                              VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel Margin="4">
                                <TextBlock Text="{_:Lang 511}" VerticalAlignment="Center" />
                                <ComboBox Name="CmbParametersCopier" />
                            </DockPanel>
                            <DockPanel Margin="4">
                                <TextBlock Text="{_:Lang 512}" VerticalAlignment="Center" />
                                <ComboBox Name="CmbFightsConfigurationsCopier" />
                            </DockPanel>
                            <Button Width="120" Height="32"
                                    Background="{StaticResource AccentColorBrush}"
                                    Click="BtnCopy_Click"
                                    HorizontalAlignment="Right"
                                    Margin="4 6 4 4">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="CheckBold" />
                                    <TextBlock Margin="10 0 0 0" Text="{_:Lang 570}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>

            </StackPanel>
        </TabItem>
 
        <!-- Accounts Replacement -->
        <TabItem Controls:ControlsHelper.HeaderFontSize="16" Width="213">
            <TabItem.HeaderTemplate>
                <DataTemplate>
                    <StackPanel Height="22" Margin="0 2 0 0" Orientation="Horizontal">
                        <iconPacks:PackIconMaterial VerticalAlignment="Center" Kind="FindReplace" />
                        <TextBlock VerticalAlignment="Center" FontSize="15"
                                   Margin="10 0 0 0" Text="{_:Lang 752}" />
                    </StackPanel>
                </DataTemplate>

            </TabItem.HeaderTemplate>

            <DockPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="BtnSelectAll_OnClick"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Tag="2"
                                    ToolTip="{_:Lang 502}">
                            <iconPacks:PackIconMaterial Width="12" Height="12" Kind="SelectAll" />
                        </Button>
                        <Button Click="BtnUnselectAll_OnClick"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Tag="2"
                                    ToolTip="{_:Lang 503}">
                            <iconPacks:PackIconMaterial Width="12" Height="12" Kind="SelectOff" />
                        </Button>
                    </StackPanel>
                    <!-- Accounts list -->
                    <ListBox ItemsSource="{Binding AccountsReplacementList}"
                             Name="LbAccountsListReplacement"
                             SelectionChanged="LbAccountsListReplacement_SelectionChanged"
                             SelectionMode="Multiple"
                             Width="150" Height="229"
                             BorderThickness="0.6">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel VerticalAlignment="Stretch">
                                    <CheckBox Margin="-1 1 0 0"
                                              IsChecked="{Binding IsSelected, 
                                                          RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}">
                                    </CheckBox>
                                    <TextBlock Text="{Binding Username}" Foreground="{Binding UsernameColor}" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Margin="0 20 0 0" Height="200" Width="145">

                        <Button Width="135" Height="32"
                                    Name="BtnAddReplacement"
                                    Click="BtnAddReplacement_Click"
                                    HorizontalAlignment="Center"
                                    FontSize="9.5"
                                    Background="{StaticResource AccentColorBrush}"
                                    Margin="4 24 2 0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="AccountPlus" />
                                <TextBlock Margin="4 0 0 0" Text="{_:Lang 764}" />
                            </StackPanel>
                        </Button>
                        
                        <Button Width="135" Height="32"
                                    Name="BtnAddReplacements"
                                    Click="BtnAddReplacements_Click"
                                    HorizontalAlignment="Center"
                                    FontSize="9.5"
                                    Background="{StaticResource AccentColorBrush}"
                                    Margin="4 24 2 0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="AccountMultiplePlus" />
                                <TextBlock Margin="4 0 0 0" Text="{_:Lang 765}" />
                            </StackPanel>
                        </Button>

                        <Button Width="135" Height="32"
                                    IsEnabled="False"
                                    Name="BtnRemoveReplacement"
                                    Click="BtnRemoveReplacement_Click"
                                    HorizontalAlignment="Center"
                                    FontSize="9.5"
                                    Background="{StaticResource AccentColorBrush}"
                                    Margin="4 24 2 0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="AccountRemove" />
                                <TextBlock Margin="4 0 0 0" Text="{_:Lang 766}" />
                            </StackPanel>
                        </Button>
                        
                        <TextBlock Margin="0 15 0 0" Name="LabelAvailableAccounts" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <!-- Options -->
                <StackPanel >
                    <GroupBox Header="{_:Lang 757}">
                        <TabControl Controls:TabControlHelper.Underlined="TabPanel" Margin="0,0,0,0" Height="235" SelectionChanged="TabReplacement_SelectionChanged">
                            <!-- Manual -->
                            <TabItem x:Name="ManualReplacementTab">
                                <TabItem.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Height="20" Margin="0 2 0 0" Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial VerticalAlignment="Center" Kind="Assistant" />
                                            <TextBlock VerticalAlignment="Center"
                                                   FontSize="15"
                                                   Margin="10 0 0 0"
                                                   Text="{_:Lang 758}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </TabItem.HeaderTemplate>

                                
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Height="55" Margin="0,0,0.2,0" Orientation="Vertical" Width="339">
                                        <iconPacks:PackIconMaterial Width="14"
                                            Height="14"
                                            HorizontalAlignment="Center"
                                            Kind="Information" Margin="155,0,154.2,0" />
                                        <TextBlock Margin="4,10,-0.8,0"
                                                   FontSize="9"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Text="{_:Lang 772}" />       
                                    </StackPanel>

                                    <Button Name="BtnSaveMultipleAccountsReplacement"
                                            Click="BtnSaveMultipleAccountsReplacement_Click"
                                            Width="300"
                                            Margin="0 20 0 0"
                                            IsEnabled="False"
                                            Background="{StaticResource AccentColorBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="CheckCircle" Margin="0 0 12 0" />
                                            <TextBlock Margin="0 0 0 0" Text="{_:Lang 769}" />
                                        </StackPanel>
                                        <Button.Triggers>
                                            <EventTrigger RoutedEvent="Button.Click">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation To="Green"
                                                        Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                        FillBehavior="Stop"
                                                        AutoReverse="True"
                                                        Duration="0:0:2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </StackPanel>
                            </TabItem>

                            <!-- Automatic -->
                            <TabItem Name="AutoReplacementTab">
                                <TabItem.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Height="20" Margin="0 2 0 0" Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial VerticalAlignment="Center" Kind="Autorenew" />
                                            <TextBlock VerticalAlignment="Center" FontSize="15" Margin="10 0 0 0"
                                                   Text="{_:Lang 759}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </TabItem.HeaderTemplate>

                                <StackPanel Margin="-5 0 0 0" Height="200">
                                    <GroupBox Height="100">
                                        <StackPanel>
                                            <DockPanel Margin="4" VerticalAlignment="Center">
                                                <CheckBox x:Name="CbActivateReplacement"
                                                          IsChecked="{Binding ElementName=LbAccountsListReplacement, Path=SelectedItem.ReplacementConfiguration.ActivateReplacement}"
                                                          Margin="4 0 0 0"
                                                          DockPanel.Dock="Left" />
                                                <TextBlock Text="{_:Lang 775}" FontWeight="Bold"/>
                                            </DockPanel>
                                            <DockPanel Margin="4" VerticalAlignment="Center">
                                                <CheckBox Name="CbConnectAfterReplacement"
                                                          IsChecked="{Binding ElementName=LbAccountsListReplacement, Path=SelectedItem.ReplacementConfiguration.ConnectAfterReplacement}"
                                                          IsEnabled="{Binding ElementName=CbActivateReplacement, Path=IsChecked, TargetNullValue=false}"
                                                          Margin="4 0 0 0"/>
                                                <TextBlock Text="{_:Lang 776}" VerticalAlignment="Center" FontSize="9"/>

                                                <Separator Style="{DynamicResource SeparatorStyle}" />
                                                <TextBlock Text="{_:Lang 777}" VerticalAlignment="Center" FontSize="9" />
                                                <TextBlock Name="Txt" />
                                                <Controls:NumericUpDown Name="DisconnectTimer"
                                                                        Value="{Binding ElementName=LbAccountsListReplacement, Path=SelectedItem.ReplacementConfiguration.DisconnectTimer}"
                                                                        IsEnabled="{Binding ElementName=CbActivateReplacement, Path=IsChecked, TargetNullValue=false}"
                                                                        Width="20"
                                                                        Minimum="0"
                                                                        HideUpDownButtons="True" />
                                                
                                            </DockPanel>
                                            <DockPanel Margin="4" VerticalAlignment="Center">
                                                <CheckBox Name="CbStartScript"
                                                          IsChecked="{Binding ElementName=LbAccountsListReplacement, Path=SelectedItem.ReplacementConfiguration.StartScript}"
                                                          IsEnabled="{Binding ElementName=CbActivateReplacement, Path=IsChecked, TargetNullValue=false}"
                                                          Margin="4 0 0 0"/>
                                                <TextBlock Text="{_:Lang 778}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Height="60">
                                        <StackPanel Margin="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <DockPanel Margin="4" VerticalAlignment="Center">
                                                <CheckBox Name="CbCreateCharacter"
                                                          IsChecked="{Binding ElementName=LbAccountsListReplacement, Path=SelectedItem.ReplacementConfiguration.SubstituteCharacterCreation.Create}"
                                                          IsEnabled="{Binding ElementName=CbActivateReplacement, Path=IsChecked, TargetNullValue=false}"
                                                          Margin="4 0 0 0"
                                                          DockPanel.Dock="Left" />
                                                <TextBlock Text="{_:Lang 774}" />
                                            </DockPanel>
                                            <Button x:Name="BtnCharacterCreator" IsEnabled="{Binding ElementName=CbActivateReplacement, Path=IsChecked, TargetNullValue=false}" Margin="20 0 0 0" Content="{_:Lang 773}" Background="{StaticResource AccentColorBrush}" Click="BtnCharacterCreator_Click" />
                                            <Image x:Name="ImgCharacterPreview" Cursor="No" Height="20" Width="20" Margin="4 0 0 0" DockPanel.Dock="Right" Source="/Bubble Bot;component/Resources/inactive.png"  />
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox>
                                        <StackPanel HorizontalAlignment="Center" >
                                            <Button x:Name="BtnApplyReplacementSettings" Height="20" Visibility="Collapsed" Content="{_:Lang 669}" Background="{StaticResource AccentColorBrush}" Click="BtnApplyReplacementSettings_Click" />
                                            <StackPanel x:Name="InfoReplacementSettings" Height="50" Visibility="Visible">
                                            <iconPacks:PackIconMaterial Width="14"
                                            Height="14"
                                            HorizontalAlignment="Center"
                                            Kind="Information"/>
                                            <TextBlock
                                                   FontSize="7.5"
                                                   TextWrapping="Wrap"
                                                   Text="{_:Lang 779}" />
                                        </StackPanel>
                                        </StackPanel>
                                    </GroupBox>



                                </StackPanel>
                                

                            </TabItem>
                        </TabControl>
                    </GroupBox>

                    <!-- Substitute Accounts Stock Manager -->
                    <GroupBox Header="{_:Lang 760}" Height="214" Margin="0 10 0 0">
                        <ListView Width="460"
                          x:Name="LvAccountsReplacement"
                          SelectionChanged="LvAccountsReplacement_SelectionChanged"
                          SelectionMode="Extended"
                          IsSynchronizedWithCurrentItem="True"
                          ItemsSource="{Binding SubstituteAccounts}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{_:Lang 240}"
                                        Width="185"
                                        DisplayMemberBinding="{Binding Username}" />
                                    <GridViewColumn Header="{_:Lang 245}"
                                        Width="185"
                                        DisplayMemberBinding="{Binding Password}" />
                                    <GridViewColumn Header="{_:Lang 239}" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Click="BtnRemoveSubstitute_Click">
                                                    <Button.Content>
                                                        <iconPacks:PackIconMaterial VerticalAlignment="Center" Kind="Delete" />
                                                    </Button.Content>
                                                </Button>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                    </GroupBox>
                </StackPanel>
            </DockPanel>

        </TabItem>

        <!-- Proxies -->
        <TabItem Controls:ControlsHelper.HeaderFontSize="16" Width="213">
            <TabItem.HeaderTemplate>
                <DataTemplate>
                    <StackPanel Height="22" Margin="0 2 0 0" Orientation="Horizontal">
                        <iconPacks:PackIconMaterial VerticalAlignment="Center" Kind="AccountSettings" />
                        <TextBlock VerticalAlignment="Center" FontSize="15"
                                   Margin="10 0 0 0" Text="Proxies" />
                    </StackPanel>
                </DataTemplate>
            </TabItem.HeaderTemplate>

            <DockPanel>
                <!-- Accounts list -->
                <ListBox x:Name="LbAccountsListProxy"
                         ItemsSource="{Binding Accounts}"
                         DisplayMemberPath="Username"
                         Height="500"
                         Width="140" />

                <!-- Proxy informations -->
                <StackPanel Margin="4">
                    <DockPanel Margin="4">
                        <TextBlock Text="{_:Lang 358}" VerticalAlignment="Center" Margin="0 0 2 0" />
                        <TextBox Controls:TextBoxHelper.ClearTextButton="True"
                                 Controls:TextBoxHelper.Watermark="{_:Lang 359}"
                                 Name="TxtProxyIp"
                                 Width="180"
                                 Text="{Binding ElementName=LbAccountsListProxy,
                                                Path=SelectedItem.Proxy.Ip, 
                                                Mode=OneWay, 
                                                UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{_:Lang 360}" VerticalAlignment="Center" Margin="6 0 2 0" />
                        <TextBox Controls:TextBoxHelper.ClearTextButton="True"
                                 Controls:TextBoxHelper.Watermark="8080"
                                 Name="TxtProxyPort"
                                 MaxLength="5"
                                 Text="{Binding ElementName=LbAccountsListProxy,
                                                Path=SelectedItem.Proxy.Port, 
                                                Mode=OneWay, 
                                                UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBox Controls:TextBoxHelper.ClearTextButton="True"
                             Controls:TextBoxHelper.Watermark="{_:Lang 470}"
                             Name="TxtProxyUsername"
                             Text="{Binding ElementName=LbAccountsListProxy,
                                               Path=SelectedItem.Proxy.Username, 
                                               Mode=OneWay, 
                                               UpdateSourceTrigger=PropertyChanged}"
                             Margin="4" />
                    <TextBox Controls:TextBoxHelper.ClearTextButton="True"
                             Controls:TextBoxHelper.Watermark="{_:Lang 471}"
                             Name="TxtProxyPassword"
                             Text="{Binding ElementName=LbAccountsListProxy,
                                               Path=SelectedItem.Proxy.Password, 
                                               Mode=OneWay, 
                                               UpdateSourceTrigger=PropertyChanged}"
                             Margin="4" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Width="130" Height="32"
                                Content="{_:Lang 676}"
                                Click="BtnResetProxy_Click"
                                Margin="0 6 8 4" />
                        <Button Width="130" Height="32"
                                Content="{_:Lang 361}"
                                Click="BtnTestProxy_Click"
                                Margin="0 6 4 4" />
                        <Button Width="120" Height="32"
                                Name="BtnSaveProxy"
                                Background="{StaticResource AccentColorBrush}"
                                Click="BtnSaveProxy_Click"
                                Margin="4 6 4 4">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CheckBold" />
                                <TextBlock Margin="10 0 0 0" Text="{_:Lang 362}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

        </TabItem>
        
    </TabControl>
</Controls:MetroWindow>