<Controls:MetroWindow
    xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
    x:Class="BubbleBot.Views.Accounts.AccountsEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:_="clr-namespace:BubbleBot.Configurations.Language"
    mc:Ignorable="d"
    Title="{_:Lang 636}"
    ResizeMode="NoResize"
    ShowMaxRestoreButton="False"
    Height="355.823" Width="357.277"
    WindowStartupLocation="CenterScreen"
    GlowBrush="{DynamicResource AccentColorBrush}"
    BorderBrush="{StaticResource AccentColorBrush}"
    FontSize="12" ShowSystemMenuOnRightClick="False">

    <DockPanel Margin="6,0,4,0" Height="339" VerticalAlignment="Top">

        <StackPanel Width="588" VerticalAlignment="Center" Margin="0,-20,0,10" Height="349">
            <Grid Height="378" HorizontalAlignment="Center" Width="581" Margin="1,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="148*" />
                    <ColumnDefinition Width="172*" />
                    <ColumnDefinition Width="256*" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            Margin="10,29,20,333"
                            Grid.ColumnSpan="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <iconPacks:PackIconMaterial Width="14"
                                                Height="14"
                                                HorizontalAlignment="Center"
                                                Kind="Information" />
                    <TextBlock Margin="4 0 0 0"
                               Text="{_:Lang 643}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBox
                    Controls:TextBoxHelper.ClearTextButton="True"
                    Controls:TextBoxHelper.Watermark="{_:Lang 244}"
                    x:Name="txtUsername" Margin="10,57,251,295" Width="315" HorizontalAlignment="Center"
                    Grid.ColumnSpan="3" />
                <PasswordBox Margin="10,98,251,254"
                             Controls:TextBoxHelper.ClearTextButton="True"
                             Controls:TextBoxHelper.Watermark="{_:Lang 245}"
                             Style="{StaticResource Win8MetroPasswordBox}"
                             FontSize="13"
                             Width="315"
                             HorizontalAlignment="Center"
                             Grid.ColumnSpan="3"
                             Name="txtPassword" />
                <ComboBox Margin="0,138,251,213"
                          Controls:TextBoxHelper.ClearTextButton="True"
                          Controls:TextBoxHelper.Watermark="{_:Lang 246}"
                          HorizontalAlignment="Right"
                          Grid.ColumnSpan="3"
                          SelectedIndex="0"
                          Width="315"
                          Name="cmbServer">
                    <ComboBoxItem Content="-" />
                    <ComboBoxItem Content="Terra Cogita" />
                    <ComboBoxItem Content="Herdegrize" />
                    <ComboBoxItem Content="Oshimo" />
                    <ComboBoxItem Content="Dodge" />
                    <ComboBoxItem Content="Brutas" />
                    <ComboBoxItem Content="Grandapan" />
                </ComboBox>
                <TextBox
                    Controls:TextBoxHelper.ClearTextButton="True"
                    Controls:TextBoxHelper.Watermark="{_:Lang 640}"
                    x:Name="txtCharacter" Margin="10,178,251,174" Width="315" HorizontalAlignment="Center"
                    Grid.ColumnSpan="3" />
                <TextBox
                    Controls:TextBoxHelper.ClearTextButton="True"
                    Controls:TextBoxHelper.Watermark="{_:Lang 641}"
                    x:Name="txtGroup" Margin="10,219,251,133" Width="315" HorizontalAlignment="Center"
                    Grid.ColumnSpan="3" />
                <TextBox
                    Controls:TextBoxHelper.ClearTextButton="True"
                    Controls:TextBoxHelper.Watermark="{_:Lang 642}"
                    x:Name="txtPseudo" Margin="10,260,251,92" Width="315" HorizontalAlignment="Center"
                    Grid.ColumnSpan="3" />
                <Button HorizontalAlignment="Left"
                        x:Name="btnConfirmation"
                        Width="120"
                        Click="btnConfirmation_Click"
                        Background="{StaticResource AccentColorBrush}"
                        Margin="57,302,0,40" Grid.Column="1" Grid.ColumnSpan="2">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Check" />
                        <TextBlock Margin="10 0 0 0" Text="{_:Lang 635}" />

                    </StackPanel>
                </Button>
            </Grid>
            <StackPanel x:Name="spAlert"
                        Background="#cd5d5d"
                        Visibility="Hidden"
                        Width="380"
                        Margin="0 10 0 0">
                <TextBlock x:Name="tbAlert"
                           TextWrapping="Wrap"
                           Foreground="White"
                           Margin="10 8 10 10" />
            </StackPanel>

        </StackPanel>

    </DockPanel>

</Controls:MetroWindow>