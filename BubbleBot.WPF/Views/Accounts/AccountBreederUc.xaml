<UserControl x:Class="BubbleBot.Views.Accounts.AccountBreederUc"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BubbleBot.Views.Accounts"
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:utility="clr-namespace:BubbleBot.Converters.Utility"
             xmlns:_="clr-namespace:BubbleBot.Configurations.Language"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             Height="484"
             Width="798"
             FontSize="12">

    <UserControl.Resources>

        <!-- Converters -->
        <utility:InverseBooleanConverter x:Key="InverseBooleanConverter" />

    </UserControl.Resources>

    <ScrollViewer Height="484" VerticalAlignment="Top">
        <StackPanel Height="581">

            <!-- Start pet breeder -->
            <GroupBox Header="{_:Lang 716}">
                <StackPanel>
                    <Button x:Name="btnStart" 
                            Height="32"
                            Content="{_:Lang 717}"
                            Margin="576,6,10,4"
                            Click="Btn_Start_Breeding"/>
                </StackPanel>
            </GroupBox>

            <!-- Add an object to sell -->
            <GroupBox Header="{_:Lang 703}">
                <StackPanel>
                    <DockPanel Margin="4">
                        <TextBlock Text="{_:Lang 704}" VerticalAlignment="Center" />
                        <controls:NumericUpDown x:Name="petGID" Value="1" Minimum="1" Maximum="16000" />
                    </DockPanel>
                    <DockPanel Margin="4">
                        <TextBlock Text="{_:Lang 705}" VerticalAlignment="Center" />
                        <controls:NumericUpDown x:Name="foodGID" Value="1" Minimum="1" Maximum="16000" />
                    </DockPanel>
                    <DockPanel Margin="4">
                        <TextBlock Text="{_:Lang 706}" VerticalAlignment="Center" />
                        <controls:NumericUpDown x:Name="foodQuantity" Value="1" Minimum="1" Maximum="10000" />
                    </DockPanel>
                    <DockPanel Margin="4">
                        <TextBlock Text="{_:Lang 707}" VerticalAlignment="Center" />
                        <controls:NumericUpDown x:Name="petInterval" Value="1" Minimum="1" Maximum="5000" />
                    </DockPanel>
                    <Button x:Name="btnAdd" HorizontalAlignment="Right"
                            Width="100" Height="32"
                            Background="{StaticResource AccentColorBrush}"
                            Margin="0 6 4 4"
                            Click="BtnAdd_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Plus" />
                            <TextBlock Margin="10 0 0 0" Text="{_:Lang 260}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </GroupBox>


            <!-- Pet to breed -->
            <GroupBox Header="{_:Lang 718}">
                <ListView x:Name="lvObjects"
                      Height="240"
                      ItemsSource="{Binding Extensions.PetBreeder.PetBreederConfig.PetsToBreed}" Width="782">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{_:Lang 710}"
                                        Width="90"
                                        DisplayMemberBinding="{Binding PetID}" />
                            <GridViewColumn Header="{_:Lang 711}"
                                        Width="145"
                                        DisplayMemberBinding="{Binding NamePet}" />
                            <GridViewColumn Header="{_:Lang 712}"
                                        Width="90"
                                        DisplayMemberBinding="{Binding FoodID}" />
                            <GridViewColumn Header="{_:Lang 713}"
                                        Width="145"
                                        DisplayMemberBinding="{Binding NameFood}" />
                            <GridViewColumn Header="{_:Lang 714}"
                                        Width="90"
                                        DisplayMemberBinding="{Binding FoodQuantity}" />
                            <GridViewColumn Header="{_:Lang 715}"
                                        Width="90"
                                        DisplayMemberBinding="{Binding PetIntervalMeal}" />
                            <GridViewColumn Header="{_:Lang 719}"
                                        Width="120"
                                        DisplayMemberBinding="{Binding FedderCount}" />
                        </GridView>
                    </ListView.View>
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{_:Lang 239}" Click="BtnDelete_Click">
                                <MenuItem.Icon>
                                    <iconPacks:PackIconMaterial Margin="8 0 0 0"
                                                            Kind="Close" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>
            </GroupBox>


        </StackPanel>
    </ScrollViewer>

</UserControl>