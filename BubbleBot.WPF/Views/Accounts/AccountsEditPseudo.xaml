<Controls:MetroWindow
    xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
    x:Class="BubbleBot.Views.Accounts.AccountsEditPseudo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:_="clr-namespace:BubbleBot.Configurations.Language"
    mc:Ignorable="d"
    Title="{_:Lang 633}"
    ResizeMode="NoResize"
    ShowMaxRestoreButton="False"
    Height="128" Width="339"
    WindowStartupLocation="CenterScreen"
    GlowBrush="{DynamicResource AccentColorBrush}"
    BorderBrush="{StaticResource AccentColorBrush}"
    FontSize="12" ShowSystemMenuOnRightClick="False">

    <StackPanel Margin="6,0,4,5">
        <Grid Height="26" Margin="0,0,111,0">
            <StackPanel Orientation="Vertical" />
        </Grid>
        <TextBox
            Controls:TextBoxHelper.ClearTextButton="True"
            Controls:TextBoxHelper.Watermark="{_:Lang 634}"
            x:Name="txtNickname" Height="26" Margin="23,0,18,0" />
        <Button HorizontalAlignment="Left"
                x:Name="btnConnect"
                Margin="176,10,0,0"
                Width="129" Height="28"
                Background="{StaticResource AccentColorBrush}"
                Click="btn_pseudoValidation">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="Check" />
                <TextBlock Margin="10 0 0 0" Text="{_:Lang 635}" />
            </StackPanel>
        </Button>
        <StackPanel x:Name="spAlert"
                    Background="#cd5d5d"
                    Visibility="Hidden"
                    Width="380"
                    Margin="0 10 0 0">
            <TextBlock x:Name="tbAlert"
                       TextWrapping="Wrap"
                       Foreground="White"
                       Margin="10 8 10 10" />
        </StackPanel>
        <StackPanel Margin="0,20,47,0" Height="93" HorizontalAlignment="Right" Width="283" />
        <StackPanel Orientation="Horizontal"
                    Margin="0 8"
                    HorizontalAlignment="Center" />

        <StackPanel Orientation="Horizontal"
                    Margin="0 8"
                    HorizontalAlignment="Center" />

    </StackPanel>

</Controls:MetroWindow>