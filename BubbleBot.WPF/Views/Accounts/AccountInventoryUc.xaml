<UserControl x:Class="BubbleBot.Views.Accounts.AccountInventoryUc"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:specific="clr-namespace:BubbleBot.Converters.Specific"
             xmlns:enums="clr-namespace:BubbleBot.Converters.Enums"
             xmlns:_="clr-namespace:BubbleBot.Configurations.Language"
             mc:Ignorable="d"
             Height="484"
             Width="798">

    <UserControl.Resources>
        <!-- Styling -->
        <Style x:Key="TabItemLowerFontSize" BasedOn="{StaticResource MetroTabItem}" TargetType="TabItem">
            <Setter Property="mah:ControlsHelper.HeaderFontSize" Value="15" />
        </Style>
        <Style x:Key="CustomMenuItem" TargetType="MenuItem">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#88888888" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Converters -->
        <specific:EquipementActionConverter x:Key="equipementActionConverter" />
        <enums:ObjectEffectColorConverter x:Key="objectEffectColorConverter" />
        <enums:ObjectEntryPositionStringConverter x:Key="objectEntryPositionStringConverter" />
        <specific:DropMonsterIdsToImage x:Key="dropMonsterIdsToImage" />
        <specific:DropMonsterIdsToBestiaryUrl x:Key="dropMonsterIdsToBestiaryUrl" />
        <specific:DropMonsterIdsVisiblityBoolean x:Key="dropMonsterIdsVisiblityBoolean" />
    </UserControl.Resources>

    <TabControl Controls:TabControlHelper.Underlined="TabPanel" SelectionChanged="TabControl_SelectionChanged">
        <!-- Equipements -->
        <TabItem Style="{StaticResource TabItemLowerFontSize}">
            <TabItem.HeaderTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Margin="-4 2 0 0" Kind="Sword" />
                        <TextBlock Margin="2 0 0 0" Text="{_:Lang 316}" />
                    </StackPanel>
                </DataTemplate>
            </TabItem.HeaderTemplate>
            <ListView ItemsSource="{Binding Game.Character.Inventory.Equipements}"
                      FontSize="12" Height="440">
                <ListView.Resources>
                    <!-- ContextMenu Zone Equipement -->
                    <ContextMenu x:Key="ItemContextMenu" BorderThickness="0" HasDropShadow="False">
                        <ContextMenu.Background>
                            <SolidColorBrush>
                                <SolidColorBrush.Color>
                                    <Color A="120" R="8" G="9" B="7" />
                                </SolidColorBrush.Color>
                            </SolidColorBrush>
                        </ContextMenu.Background>
                        <MenuItem x:Name="ItemName" IsEnabled="False" Foreground="#e1e1e1"
                                  Style="{StaticResource CustomMenuItem}">
                            <MenuItem.Header>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.2*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Margin="-10 15 0 0">
                                        <Run FontWeight="DemiBold" Text="{Binding Name, Mode=OneWay}" />
                                        <LineBreak />
                                        <Run Text="{_:Lang 262}" />
                                        <Run Text="{Binding Level, Mode=OneWay}" />
                                    </TextBlock>
                                    <Rectangle Margin="35 15 0 0" Grid.Column="2" Fill="#3c3a32" Width="60" Height="60"
                                               Opacity="0.65">
                                        <Rectangle.Clip>
                                            <RectangleGeometry Rect="0,0,60,60" RadiusX="4" RadiusY="4" />
                                        </Rectangle.Clip>
                                    </Rectangle>
                                    <Image Margin="35 15 0 0" Grid.Column="2" Width="50" Height="50"
                                           Source="{Binding IconUrl, IsAsync=True, Mode=OneWay}" />
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem FontWeight="DemiBold" Header="{_:Lang 682}" IsEnabled="False" Foreground="#e1e1e1"
                                  Style="{StaticResource CustomMenuItem}" />
                        <MenuItem x:Name="Effects" Margin="5 5 0 0" IsEnabled="False" Foreground="#e1e1e1"
                                  Style="{StaticResource CustomMenuItem}">
                            <MenuItem.Header>
                                <ListBox ItemsSource="{Binding ObjectEffectsToString}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.Background>
                                        <SolidColorBrush Color="Transparent" Opacity="1" />
                                    </ListBox.Background>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0 -3 0 0" FontWeight="SemiBold" Text="{Binding}"
                                                       Foreground="{Binding Converter={StaticResource objectEffectColorConverter}}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Margin="-10 8 0 10" IsEnabled="False" Foreground="#e1e1e1"
                                  Style="{StaticResource CustomMenuItem}">
                            <MenuItem.Header>
                                <TextBlock>
                                    <Run Text="{_:Lang 683}" />
                                    <Run Text=":" />
                                    <Run FontWeight="DemiBold" Text="{Binding StringType, Mode=OneWay}" />
                                    <LineBreak />
                                    <Run Text="{_:Lang 696}" />
                                    <Run Text=":" />
                                    <Run FontWeight="DemiBold"
                                         Text="{Binding RealWeight, Mode=OneWay, StringFormat={}{0} pods}" />
                                    <LineBreak />
                                    <Run Text="{_:Lang 697}" />
                                    <Run Text=":" />
                                    <Run FontWeight="DemiBold"
                                         Text="{Binding Price, Mode=OneWay, StringFormat={}{0} K}" />
                                </TextBlock>
                            </MenuItem.Header>
                        </MenuItem>
                    </ContextMenu>
                    <!-- [END] ContextMenu Zone [END]-->
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding IconUrl, IsAsync=True, Mode=OneWay}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{_:Lang 325}"
                                        Width="50"
                                        DisplayMemberBinding="{Binding GID}" />
                        <GridViewColumn Header="{_:Lang 326}"
                                        Width="224"
                                        DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="{_:Lang 317}"
                                        Width="80"
                                        DisplayMemberBinding="{Binding Quantity}" />
                        <GridViewColumn Header="{_:Lang 318}"
                                        Width="100"
                                        DisplayMemberBinding="{Binding Position,
                                                                       Converter={StaticResource objectEntryPositionStringConverter}}" />
                        <GridViewColumn Header="{_:Lang 319}"
                                        Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Content="{Binding Converter={StaticResource equipementActionConverter},
                                                              Mode=OneWay}"
                                        Margin="0 2 0 2"
                                        Click="BtnEquipUnEquip_Click" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{_:Lang 320}" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{_:Lang 320}" Click="BtnDrop_Click" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{_:Lang 321}" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{_:Lang 321}" Click="BtnDelete_Click" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </TabItem>

        <!-- Consumables -->
        <TabItem Style="{StaticResource TabItemLowerFontSize}">
            <TabItem.HeaderTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Margin="-4 2 0 0" Kind="Flask" />
                        <TextBlock Margin="2 0 0 0" Text="{_:Lang 322}" />
                    </StackPanel>
                </DataTemplate>
            </TabItem.HeaderTemplate>
            <ListView ItemsSource="{Binding Game.Character.Inventory.Consumables}"
                      FontSize="12" Height="440">
                <ListView.Resources>
                    <!-- ContextMenu Zone Consumables -->
                    <ContextMenu x:Key="ItemContextMenu" BorderThickness="0" HasDropShadow="False">
                        <ContextMenu.Background>
                            <SolidColorBrush>
                                <SolidColorBrush.Color>
                                    <Color A="120" R="8" G="9" B="7" />
                                </SolidColorBrush.Color>
                            </SolidColorBrush>
                        </ContextMenu.Background>
                        <MenuItem x:Name="ConsumableItem" IsEnabled="False" Foreground="#e1e1e1"
                                  Style="{StaticResource CustomMenuItem}">
                            <MenuItem.Header>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.2*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Margin="-10 15 0 0">
                                        <Run FontWeight="DemiBold" Text="{Binding Name, Mode=OneWay}" />
                                        <LineBreak />
                                        <Run Text="{_:Lang 262}" />
                                        <Run Text="{Binding Level, Mode=OneWay}" />
                                    </TextBlock>
                                    <Rectangle Margin="35 15 0 0" Grid.Column="2" Fill="#3c3a32" Width="60" Height="60"
                                               Opacity="0.65">
                                        <Rectangle.Clip>
                                            <RectangleGeometry Rect="0,0,60,60" RadiusX="4" RadiusY="4" />
                                        </Rectangle.Clip>
                                    </Rectangle>
                                    <Image Margin="35 15 0 0" Grid.Column="2" Width="50" Height="50"
                                           Source="{Binding IconUrl, IsAsync=True, Mode=OneWay}" />
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem x:Name="EffectsConsumable" Margin="5 5 0 0" IsEnabled="False" Foreground="#e1e1e1"
                                  Style="{StaticResource CustomMenuItem}">
                            <MenuItem.Header>
                                <ListBox ItemsSource="{Binding ObjectEffectsToString}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.Background>
                                        <SolidColorBrush Color="Transparent" Opacity="1" />
                                    </ListBox.Background>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0 -3 0 0" FontWeight="SemiBold" Text="{Binding}"
                                                       Foreground="{Binding Converter={StaticResource objectEffectColorConverter}, IsAsync=True, Mode=OneWay}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Margin="-10 8 0 0" Foreground="#e1e1e1" Style="{StaticResource CustomMenuItem}">
                            <MenuItem.Header>
                                <TextBlock>
                                    <Run Text="{_:Lang 683}" />
                                    <Run Text=":" />
                                    <Run FontWeight="DemiBold" Text="{Binding StringType, Mode=OneWay}" />
                                    <LineBreak />
                                    <Run Text="{_:Lang 696}" />
                                    <Run Text=":" />
                                    <Run FontWeight="DemiBold"
                                         Text="{Binding RealWeight, Mode=OneWay, StringFormat={}{0} pods}" />
                                    <LineBreak />
                                    <Run Text="{_:Lang 697}" />
                                    <Run Text=":" />
                                    <Run FontWeight="DemiBold"
                                         Text="{Binding Price, Mode=OneWay, StringFormat={}{0} K}" />
                                    <LineBreak />
                                </TextBlock>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Margin="-15 -5 0 15" FontSize="12.5" IsEnabled="False" Foreground="Orange"
                                  Style="{StaticResource CustomMenuItem}">
                            <MenuItem.Header>
                                <TextBlock Width="250" TextWrapping="WrapWithOverflow">
                                    <Run Text="{Binding Description, Mode=OneWay}" />
                                </TextBlock>
                            </MenuItem.Header>
                        </MenuItem>
                    </ContextMenu>
                    <!-- [END] ContextMenu Zone [END]-->
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding IconUrl, IsAsync=True, Mode=OneWay}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{_:Lang 325}"
                                        Width="50"
                                        DisplayMemberBinding="{Binding GID}" />
                        <GridViewColumn Header="{_:Lang 326}"
                                        Width="380"
                                        DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="{_:Lang 317}"
                                        Width="80"
                                        DisplayMemberBinding="{Binding Quantity}" />
                        <GridViewColumn Header="{_:Lang 323}" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{_:Lang 323}" Click="BtnUse_Click" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{_:Lang 320}" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Margin="0 2 0 2" Content="{_:Lang 320}" Click="BtnDrop_Click" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{_:Lang 321}" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{_:Lang 321}" Click="BtnDelete_Click" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </TabItem>

        <!-- Resources -->
        <TabItem Style="{StaticResource TabItemLowerFontSize}">
            <TabItem.HeaderTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Margin="-4 2 0 0" Kind="Cube" />
                        <TextBlock Margin="2 0 0 0" Text="{_:Lang 324}" />
                    </StackPanel>
                </DataTemplate>
            </TabItem.HeaderTemplate>
            <ListView ItemsSource="{Binding Game.Character.Inventory.Resources}"
                      FontSize="12" Height="440">
                <ListView.Resources>
                    <!-- ContextMenu Zone Resources -->
                    <ContextMenu x:Key="ItemContextMenu" BorderThickness="0" HasDropShadow="False">
                        <ContextMenu.Background>
                            <SolidColorBrush>
                                <SolidColorBrush.Color>
                                    <Color A="120" R="8" G="9" B="7" />
                                </SolidColorBrush.Color>
                            </SolidColorBrush>
                        </ContextMenu.Background>
                        <MenuItem x:Name="ResourceItem" IsEnabled="False" Foreground="#e1e1e1"
                                  Style="{StaticResource CustomMenuItem}">
                            <MenuItem.Header>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.2*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Margin="-15 15 40 0">
                                        <Run FontWeight="DemiBold" Text="{Binding Name, Mode=OneWay}" />
                                        <LineBreak />
                                        <Run Text="{_:Lang 262}" />
                                        <Run Text="{Binding Level, Mode=OneWay}" />
                                    </TextBlock>
                                    <Rectangle Margin="35 15 0 0" Grid.Column="2" Fill="#3c3a32" Width="60" Height="60"
                                               Opacity="0.65">
                                        <Rectangle.Clip>
                                            <RectangleGeometry Rect="0,0,60,60" RadiusX="4" RadiusY="4" />
                                        </Rectangle.Clip>
                                    </Rectangle>
                                    <Image Margin="35 15 0 0" Grid.Column="2" Width="50" Height="50"
                                           Source="{Binding IconUrl, IsAsync=True, Mode=OneWay}" />
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem x:Name="DropableZone" Margin="0 5 0 0" Foreground="#e1e1e1"
                                  Style="{StaticResource CustomMenuItem}"
                                  IsEnabled="{Binding SortedDropMonsterIdsIsEmpty}">
                            <MenuItem.Header>
                                <ListBox ItemsSource="{Binding SortedDropMonsterIds, IsAsync=True, Mode=OneWay}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel IsItemsHost="True" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.Background>
                                        <SolidColorBrush Color="Transparent" Opacity="1" />
                                    </ListBox.Background>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Hyperlink
                                                    IsEnabled="{Binding Converter={StaticResource dropMonsterIdsVisiblityBoolean}}"
                                                    ToolTip="{_:Lang 698}" RequestNavigate="Hyperlink_RequestNavigate"
                                                    NavigateUri="{Binding Converter={StaticResource dropMonsterIdsToBestiaryUrl}, IsAsync=True, Mode=OneWay}">
                                                    <Image Margin="0 -3 0 0" Width="32" Height="32"
                                                           Source="{Binding Converter={StaticResource dropMonsterIdsToImage}}" />
                                                </Hyperlink>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Margin="-10 8 0 0" IsEnabled="False" Foreground="#e1e1e1"
                                  Style="{StaticResource CustomMenuItem}">
                            <MenuItem.Header>
                                <TextBlock>
                                    <Run Text="{_:Lang 683}" />
                                    <Run Text=":" />
                                    <Run FontWeight="DemiBold" Text="{Binding StringType, Mode=OneWay}" />
                                    <LineBreak />
                                    <Run Text="{_:Lang 696}" />
                                    <Run Text=":" />
                                    <Run FontWeight="DemiBold"
                                         Text="{Binding RealWeight, Mode=OneWay, StringFormat={}{0} pods}" />
                                    <LineBreak />
                                    <Run Text="{_:Lang 697}" />
                                    <Run Text=":" />
                                    <Run FontWeight="DemiBold"
                                         Text="{Binding Price, Mode=OneWay, StringFormat={}{0} K}" />
                                    <LineBreak />
                                </TextBlock>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Margin="-15 -5 0 15" FontSize="12" FontStyle="Italic" IsEnabled="False"
                                  Foreground="DimGray" Style="{StaticResource CustomMenuItem}">
                            <MenuItem.Header>
                                <TextBlock Width="250" TextWrapping="WrapWithOverflow">
                                    <Run Text="{Binding Description, Mode=OneWay}" />
                                </TextBlock>
                            </MenuItem.Header>
                        </MenuItem>
                    </ContextMenu>
                    <!-- [END] ContextMenu Zone [END]-->
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding IconUrl, IsAsync=True, Mode=OneWay}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{_:Lang 325}"
                                        Width="50"
                                        DisplayMemberBinding="{Binding GID}" />
                        <GridViewColumn Header="{_:Lang 326}"
                                        Width="464"
                                        DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="{_:Lang 317}"
                                        Width="80"
                                        DisplayMemberBinding="{Binding Quantity}" />
                        <GridViewColumn Header="{_:Lang 320}" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Margin="0 2 0 2" Content="{_:Lang 320}" Click="BtnDrop_Click" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{_:Lang 321}" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{_:Lang 321}" Click="BtnDelete_Click" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </TabItem>

        <!-- Quest Objects -->
        <TabItem Style="{StaticResource TabItemLowerFontSize}">
            <TabItem.HeaderTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Margin="-4 2 0 0" Kind="KeyVariant" />
                        <TextBlock Margin="2 0 0 0" Text="{_:Lang 327}" />
                    </StackPanel>
                </DataTemplate>
            </TabItem.HeaderTemplate>
            <ListView ItemsSource="{Binding Game.Character.Inventory.QuestObjects}"
                      FontSize="12" Height="440">
                <ListView.Resources>
                    <!-- ContextMenu Zone Quest -->
                    <ContextMenu x:Key="ItemContextMenu" BorderThickness="0" HasDropShadow="False">
                        <ContextMenu.Background>
                            <SolidColorBrush>
                                <SolidColorBrush.Color>
                                    <Color A="120" R="8" G="9" B="7" />
                                </SolidColorBrush.Color>
                            </SolidColorBrush>
                        </ContextMenu.Background>
                        <MenuItem x:Name="QuestItem" IsEnabled="False" Foreground="#e1e1e1"
                                  Style="{StaticResource CustomMenuItem}">
                            <MenuItem.Header>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.2*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Margin="-15 15 40 0">
                                        <Run FontWeight="DemiBold" Text="{Binding Name, Mode=OneWay}" />
                                        <LineBreak />
                                        <Run Text="{_:Lang 262}" />
                                        <Run Text="{Binding Level, Mode=OneWay}" />
                                    </TextBlock>
                                    <Rectangle Margin="35 15 0 0" Grid.Column="2" Fill="#3c3a32" Width="60" Height="60"
                                               Opacity="0.65">
                                        <Rectangle.Clip>
                                            <RectangleGeometry Rect="0,0,60,60" RadiusX="4" RadiusY="4" />
                                        </Rectangle.Clip>
                                    </Rectangle>
                                    <Image Margin="35 15 0 0" Grid.Column="2" Width="50" Height="50"
                                           Source="{Binding IconUrl, IsAsync=True, Mode=OneWay}" />
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Margin="-15 8 0 15" FontSize="12" FontStyle="Italic" IsEnabled="False"
                                  Foreground="DimGray" Style="{StaticResource CustomMenuItem}">
                            <MenuItem.Header>
                                <TextBlock Width="250" TextWrapping="WrapWithOverflow">
                                    <Run Text="{Binding Description, Mode=OneWay}" />
                                </TextBlock>
                            </MenuItem.Header>
                        </MenuItem>
                    </ContextMenu>
                    <!-- [END] ContextMenu Zone [END]-->
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding IconUrl, IsAsync=True, Mode=OneWay}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{_:Lang 325}"
                                        Width="50"
                                        DisplayMemberBinding="{Binding GID}" />
                        <GridViewColumn Header="{_:Lang 326}"
                                        Width="600"
                                        DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="{_:Lang 317}"
                                        Width="80"
                                        DisplayMemberBinding="{Binding Quantity}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </TabItem>

    </TabControl>

</UserControl>