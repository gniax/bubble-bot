<UserControl x:Class="BubbleBot.Views.Accounts.AccountSubscriptionUc"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:utility="clr-namespace:BubbleBot.Converters.Utility"
             xmlns:_="clr-namespace:BubbleBot.Configurations.Language"
             mc:Ignorable="d"
             Height="320"
             Width="720"
             FontSize="12">

    <UserControl.Resources>

        <!-- Converters -->
        <utility:InverseBooleanConverter x:Key="InverseBooleanConverter" />

    </UserControl.Resources>

    <StackPanel>
        <!-- Options -->
        <GroupBox Header="{_:Lang 607}"
                  Height="200"
                  Width="650" Margin="35,0">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="{_:Lang 608}" VerticalAlignment="Center" />
                    <TextBox x:Name="SubscriptionCost"
                             FontWeight="Bold"
                             IsReadOnly="True"
                             Margin="4 15 4 15"
                             Width="500"
                             Height="32" />
                </DockPanel>


                <StackPanel Orientation="Horizontal">
                    <Button Height="64" Width="300"
                            x:Name="BtnShow"
                            Content="{_:Lang 609}"
                            Margin="4 6 20 4"
                            Click="BtnShow_Click"
                            HorizontalAlignment="Left" />

                    <Button Height="64"
                            x:Name="BtnBuy"
                            Width="300"
                            Content="{_:Lang 610}"
                            Margin="4 6 4 4"
                            Click="BtnBuy_Click"
                            IsEnabled="False" HorizontalAlignment="Right" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ProgressBar Visibility="Hidden" Height="16" Width="350" Maximum="345"
                                 Margin="0 8 8 0"
                                 x:Name="ProgressBar"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center" />
                </StackPanel>

            </StackPanel>
        </GroupBox>
        <StackPanel x:Name="spAlert"
                    Background="#cd5d5d"
                    Visibility="Hidden"
                    Width="350"
                    Height="45"
                    Margin="185,10,185,0">
            <TextBlock x:Name="tbAlert"
                       TextWrapping="Wrap"
                       Foreground="White"
                       Margin="10 8 10 10" HorizontalAlignment="Center" />
        </StackPanel>
        <!-- Options -->

    </StackPanel>

</UserControl>